# Copy to .env.local and fill in. Never commit real values.

# Supabase project URL and PUBLISHABLE key (Project Settings → API Keys).
# The publishable key is safe in the browser; RLS protects the data.
# Do NOT put the secret/service_role key in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public URL of this site (used in auth email links and metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
